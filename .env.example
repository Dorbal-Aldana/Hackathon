# Crea una clave en https://aistudio.google.com/apikey
# Solo se lee en el servidor. Nunca uses VITE_GEMINI_API_KEY.
GEMINI_API_KEY=
# Selecciona un modelo que esté disponible en tu proyecto y soporte JSON estructurado.
GEMINI_MODEL=
# Define una contraseña docente antes de usar Gemini.
TEACHER_PASSWORD=
PORT=3000

# En Vercel, configura una base Upstash Redis para persistir progreso y sesiones.
# Sin estas variables, la demo funciona temporalmente, pero los datos se pueden perder.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
